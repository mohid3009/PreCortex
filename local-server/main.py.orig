import os
import tempfile
from pathlib import Path
import json
import traceback
from fastapi import FastAPI, UploadFile, File
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from tribev2 import TribeModel

app = FastAPI()

# Allow cross-origin requests across network
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Global model instance
model = None

@app.get("/health")
def health():
    device = None
    if model is not None:
        inner_model = getattr(model, "_model", None)
        if inner_model is not None and hasattr(inner_model, "device"):
            device = str(inner_model.device)
        else:
            device = "loaded"
    return {
        "status": "ok",
        "model_loaded": model is not None,
        "device": device
    }

@app.on_event("startup")
def load_model():
    global model
    try:
        # Load model using cuda if available
        model = TribeModel.from_pretrained("facebook/tribev2", device="cuda")
        print("TRIBE v2 model loaded successfully on GPU (cuda).")
    except Exception as e:
        print(f"Failed to load model on cuda: {e}. Retrying with device='auto'...")
        try:
            model = TribeModel.from_pretrained("facebook/tribev2", device="auto")
            print("TRIBE v2 model loaded successfully with device='auto'.")
        except Exception as e2:
            print(f"Critical error: Could not load TRIBE v2 model: {e2}")
            model = None

@app.post("/simulate")
async def simulate(file: UploadFile = File(...)):
    if model is None:
        return JSONResponse(
            status_code=500,
            content={"error": "TRIBE v2 model is not loaded/initialized."}
        )
    
    try:
        # Get suffix from filename to preserve modality detection
        filename = file.filename or "input.txt"
        suffix = Path(filename).suffix.lower()
        if not suffix:
            suffix = ".txt"
            
        # Write contents to a temporary file
        contents = await file.read()
        with tempfile.NamedTemporaryFile(delete=False, suffix=suffix) as temp_file:
            temp_file.write(contents)
            temp_file_path = temp_file.name
            
        try:
            # Determine correct kwargs for get_events_dataframe based on file extension
            kwargs = {}
            if suffix in [".mp4", ".avi", ".mkv", ".mov", ".webm"]:
                kwargs["video_path"] = temp_file_path
            elif suffix in [".wav", ".mp3", ".ogg", ".flac", ".m4a", ".aac"]:
                kwargs["audio_path"] = temp_file_path
            else:
                # Default fallback is text
                kwargs["text_path"] = temp_file_path
                
            # Run inference using the loaded model
            events = model.get_events_dataframe(**kwargs)
            predictions, segments = model.predict(events)
            
            # Convert predictions array/tensor to list
            if hasattr(predictions, "tolist"):
                tensor_list = predictions.tolist()
            else:
                tensor_list = list(predictions)
                
            n_timesteps = len(tensor_list)
            n_vertices = len(tensor_list[0]) if n_timesteps > 0 else 0
            
            # Calculate effective sampling rate matching the actual returned tensor rows
            input_duration_seconds = 0.0
            if events is not None and hasattr(events, "empty") and not events.empty:
                if "start" in events.columns and "duration" in events.columns:
                    input_duration_seconds = float((events["start"] + events["duration"]).max())
                elif "duration" in events.columns:
                    input_duration_seconds = float(events["duration"].sum())

            if input_duration_seconds <= 0 and segments:
                try:
                    input_duration_seconds = float(max(getattr(s, "end", getattr(s, "offset", 0) + getattr(s, "duration", 0)) for s in segments))
                except Exception:
                    pass

            if input_duration_seconds > 0 and n_timesteps > 0:
                sampling_rate_hz = round(float(n_timesteps / input_duration_seconds), 4)
            else:
                sampling_rate_hz = 1.0

            return {
                "tensor": tensor_list,
                "n_timesteps": n_timesteps,
                "n_vertices": n_vertices,
                "sampling_rate_hz": sampling_rate_hz
            }
            
        finally:
            # Cleanup temp file
            if os.path.exists(temp_file_path):
                os.remove(temp_file_path)
                
    except Exception as e:
        error_details = f"Error during simulation: {str(e)}\n{traceback.format_exc()}"
        print(error_details)
        return JSONResponse(
            status_code=500,
            content={"error": error_details}
        )
